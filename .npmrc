# pnpm 이 git URL 의존성 (@tradelab/backend) 의 prepare 단계에서 build:types
# 를 실행할 때, 백엔드의 .npmrc 가 적용되지 않아 default symlinked 레이아웃이
# 쓰임. 그러면 @types/qs 가 .pnpm/... 깊은 경로에 들어가서 tsc 가 TS2742
# (non-portable .d.ts path) 로 실패. frontend 측 .npmrc 도 hoisted 로 두면
# 동일 레이아웃이 적용되어 build:types 가 portable path 를 만들 수 있음.
node-linker=hoisted
